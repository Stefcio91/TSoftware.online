# Konfiguracja serwera tsoftware.online (server/server.js).
# Skopiuj do `.env` (ten plik nie trafia do repozytorium) i uzupełnij.
# systemd czyta go przez EnvironmentFile=, Docker Compose przez env_file:.

# --- Sieć ---
# Port i adres nasłuchiwania. Za Caddy zostaw 127.0.0.1 (świat wchodzi przez Caddy po HTTPS).
PORT=3000
HOST=127.0.0.1

# Liczba zaufanych proxy przed serwerem. Z Caddy/nginx ustaw 1 – wtedy serwer czyta
# X-Forwarded-For (limity żądań per IP) i X-Forwarded-Proto (ciasteczko Secure, HSTS).
# Bez proxy zostaw 0, inaczej klient mógłby podszyć się pod dowolny adres.
TRUST_PROXY=1

# Publiczny adres strony (używany w treści powiadomień – link do panelu).
PUBLIC_URL=https://tsoftware.online

# --- Katalogi (domyślne zwykle wystarczają) ---
# STATIC_DIR – katalog ze stroną (domyślnie katalog repozytorium, czyli rodzic server/).
# DATA_DIR   – gdzie leżą leads.json, magnet.json, settings.json i sekret sesji (domyślnie server/data).
#STATIC_DIR=/opt/tsoftware
#DATA_DIR=/opt/tsoftware/server/data

# --- Panel (/admin/) ---
# Hasło do panelu – WYMAGANE, bez niego /api/admin/* odpowiada 503.
# Bezpieczniej: zamiast jawnego hasła podaj hash scrypt (wtedy ADMIN_PASSWORD może być puste):
#   node server/server.js --hash 'twoje-haslo'
ADMIN_PASSWORD=zmien-mnie
#ADMIN_PASSWORD_HASH=scrypt$...$...

# Sekret do podpisywania ciasteczka sesji (dowolny długi losowy ciąg).
# Puste = serwer generuje go raz i zapisuje w DATA_DIR/secret.
#SESSION_SECRET=

# --- Powiadomienia o nowych zgłoszeniach (opcjonalne) ---
# Te same wartości można ustawić w panelu (Ustawienia → powiadomienia); zmienne są
# wartościami domyślnymi, gdy pola w panelu są puste.
# Webhook: na każdy lead / zapis na lead magnet idzie POST JSON {type, ts, item} (np. n8n, Make).
#NOTIFY_WEBHOOK_URL=https://n8n.example.com/webhook/tsoftware
# Telegram: token bota od @BotFather i id czatu (np. z @userinfobot).
#TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
#TELEGRAM_CHAT_ID=123456789

# --- Inne ---
# Strefa czasowa dla statystyk dziennych w panelu.
TZ=Europe/Warsaw
