# Konfiguracja docker-mailserver dla mail.tsoftware.online.
# Format: tylko ZMIENNA=wartość, bez cudzysłowów i bez odwołań do innych zmiennych.
# Pełna lista zmiennych: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# --- Certyfikat TLS: ten sam, który Caddy wystawia dla mail.tsoftware.online (katalog podpięty w compose.yaml) ---
SSL_TYPE=manual
SSL_CERT_PATH=/srv/tls/mail.tsoftware.online/mail.tsoftware.online.crt
SSL_KEY_PATH=/srv/tls/mail.tsoftware.online/mail.tsoftware.online.key

# --- Antyspam i podpisy: Rspamd zamiast starszego zestawu (Amavis, SpamAssassin, OpenDKIM, OpenDMARC, policyd-spf) ---
ENABLE_RSPAMD=1
RSPAMD_LEARN=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_POSTGREY=0
# Skaner antywirusowy zjada ponad 1 GB RAM; włącz (=1), jeśli VPS ma zapas pamięci.
ENABLE_CLAMAV=0

# --- Bezpieczeństwo ---
ENABLE_FAIL2BAN=1
SPOOF_PROTECTION=1
PERMIT_DOCKER=none

# --- Reszta ---
POSTMASTER_ADDRESS=kontakt@tsoftware.online
ENABLE_POP3=0
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
TZ=Europe/Warsaw
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d

# --- Opcja: wysyłka przez zewnętrzny przekaźnik, gdy dostawca VPS blokuje port 25 (README, krok 10) ---
# Dane logowania dopisz poleceniem `setup relay add-auth`, nie tutaj.
#DEFAULT_RELAY_HOST=[smtp-relay.brevo.com]:587
